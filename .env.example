# ---------------------------------------------------------------------------
# RregulloKosovën — environment variables
# Copy to `.env` for local development. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Neon's free tier is the recommended host. Use the POOLED connection string
# for DATABASE_URL (serverless functions open many short-lived connections)
# and the DIRECT one for migrations, which need a session-level connection.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/rregullokosoven?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/rregullokosoven?sslmode=require"

# --- Authentication (required) ---------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Only needed when the deployment URL cannot be inferred (e.g. behind a proxy).
# AUTH_URL="https://rregullokosoven.org"

# --- Public app URL (required in production) --------------------------------
# Used for canonical URLs, Open Graph tags, the sitemap and share links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Object storage: Cloudflare R2 (optional) -------------------------------
# Without these, the app runs fine but the photo uploader is disabled and the
# report composer shows an explanatory notice. R2's free tier covers 10GB.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="rregullokosoven"
# Public base URL of the bucket (r2.dev subdomain or your own CDN domain).
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# --- Email (required for sign-in) -------------------------------------------
# Sign-in is passwordless: the app emails a 6-digit code. Without a provider
# nobody can log in to a deployed site.
#
# Resend's free tier is enough to run this (no card required):
#   1. Sign up at resend.com and create an API key.
#   2. Paste it below.
#   3. Until you verify your own domain, send from "onboarding@resend.dev" —
#      that address only delivers to the inbox you signed up with, which is
#      fine for testing but must be replaced before real users arrive.
RESEND_API_KEY=""

# Sender shown to recipients. Must be on a domain verified in Resend.
EMAIL_FROM="RregulloKosovën <njoftime@yourdomain.org>"

# Prints emails to the server console instead of sending them. `npm run dev`
# already does this when RESEND_API_KEY is unset; set this only when you need the
# same behaviour from a production build (the end-to-end suite does).
# Never set it on a real deployment — every sign-in code would land in the logs.
# EMAIL_TRANSPORT="console"

# --- Rate limiting (optional) ----------------------------------------------
# Salt for hashing IP addresses before they are counted or logged. Falls back
# to AUTH_SECRET when unset. Set it explicitly so rotating AUTH_SECRET does not
# silently reset every rate-limit bucket.
RATE_LIMIT_SALT=""

# --- Seeding (optional) ----------------------------------------------------
# `npm run db:seed` always creates roles, all 38 municipalities, categories and
# badges. This additionally grants the ADMIN role to one address.
# There is no password to set: sign-in is passwordless, so whoever can read this
# inbox is the administrator. Use an address you control.
SEED_ADMIN_EMAIL=""
# Local development only: inserts demo citizens and sample reports.
# This is REFUSED against a production environment, and deployments strip the
# variable entirely — a live site never shows invented reports or fake citizens.
SEED_DEMO="false"

# --- Advertising (optional) -------------------------------------------------
# WhatsApp number that the "advertise here" slots link to. International format,
# digits only — no "+", no spaces. Kosovo numbers begin with 383.
#   e.g. 38344123456  ->  +383 44 123 456
# While this is empty the ad slots still render, but show "contact coming soon"
# instead of a broken wa.me link.
NEXT_PUBLIC_ADS_WHATSAPP=""

# Set to "false" to hide every advertising slot site-wide.
NEXT_PUBLIC_ADS_ENABLED="true"

# --- Scheduled jobs (recommended) -------------------------------------------
# Shared secret for the two cron endpoints:
#
#   /api/cron/cleanup            daily — prunes the tables that grow with
#                                activity rather than content (old audit logs,
#                                already-read notifications, spent login codes).
#                                Reports, comments and votes are never deleted.
#   /api/cron/moderation-digest  twice a day — emails administrators when
#                                citizen reports are waiting for approval.
#
# Vercel sends this automatically as "Authorization: Bearer <CRON_SECRET>".
# Leave unset and both endpoints refuse every request, so neither job runs.
CRON_SECRET=""
